{
  "buildCommand": "cd Frontend && npm install && npm run build",
  "outputDirectory": "Frontend/dist",
  "installCommand": "cd Frontend && npm install",
  "rewrites": [
    { "source": "/api", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/auth", "destination": "/api/index" },
    { "source": "/auth/(.*)", "destination": "/api/index" },
    { "source": "/usuarios", "destination": "/api/index" },
    { "source": "/usuarios/(.*)", "destination": "/api/index" },
    { "source": "/proyectos", "destination": "/api/index" },
    { "source": "/proyectos/(.*)", "destination": "/api/index" },
    { "source": "/materiales", "destination": "/api/index" },
    { "source": "/materiales/(.*)", "destination": "/api/index" },
    { "source": "/movimientos", "destination": "/api/index" },
    { "source": "/movimientos/(.*)", "destination": "/api/index" },
    { "source": "/tareas", "destination": "/api/index" },
    { "source": "/tareas/(.*)", "destination": "/api/index" },
    { "source": "/turnos", "destination": "/api/index" },
    { "source": "/turnos/(.*)", "destination": "/api/index" },
    { "source": "/subcontratistas", "destination": "/api/index" },
    { "source": "/subcontratistas/(.*)", "destination": "/api/index" },
    { "source": "/solicitudes", "destination": "/api/index" },
    { "source": "/solicitudes/(.*)", "destination": "/api/index" },
    { "source": "/invitaciones", "destination": "/api/index" },
    { "source": "/invitaciones/(.*)", "destination": "/api/index" },
    { "source": "/evidencias", "destination": "/api/index" },
    { "source": "/evidencias/(.*)", "destination": "/api/index" },
    { "source": "/uploads", "destination": "/api/index" },
    { "source": "/uploads/(.*)", "destination": "/api/index" },
    { "source": "/docs", "destination": "/api/index" },
    { "source": "/docs/(.*)", "destination": "/api/index" },
    { "source": "/redoc", "destination": "/api/index" },
    { "source": "/openapi.json", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}